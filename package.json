{
  "name": "discord-work-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "once": "node --env-file-if-exists=.env src/index.ts --once",
    "preview": "node --env-file-if-exists=.env src/index.ts --dry-run",
    "test": "node --test test/*.test.ts",
    "backfill": "node --env-file-if-exists=.env src/index.ts --backfill",
    "start:ask": "node --env-file-if-exists=.env src/interactions/index.ts",
    "register:ask": "node --env-file-if-exists=.env scripts/register-ask.ts",
    "test:webhook": "node --env-file-if-exists=.env src/index.ts --test-webhook"
  }
}
