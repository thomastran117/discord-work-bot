# Required for normal execution; never commit your real webhook.
# For forum/media channels, append ?thread_id=<thread snowflake>.
DISCORD_WEBHOOK_URL=
# Optional: separate mechanical engineering new-grad channel (enables feed).
DISCORD_MECHANICAL_WEBHOOK_URL=
DATABASE_PATH=./data/jobs.db
POLL_INTERVAL_MINUTES=120
# seed: silently record existing postings per source on its first successful poll
# publish: send existing postings, subject to the per-run cap
FIRST_RUN_MODE=seed
MAX_NOTIFICATIONS_PER_RUN=25
SIMPLIFY_ENABLED=true
SIMPLIFY_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json
# Employer boards, configured in config/boards.json
BOARDS_PATH=./config/boards.json

# Optional Canadian curated feeds (review terms before enabling)
FEEDS_PATH=./config/feeds.json

# Direct Workday / Oracle employer career sources
CAREERS_PATH=./config/careers.json

# Optional /ask HTTP service (local development)
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=
# JOBS_SNAPSHOT_URL=https://raw.githubusercontent.com/thomastran117x/discord-work-bot/bot-state/jobs.json
# PORT=8080
# DISCORD_BOT_TOKEN=  # local command registration only
